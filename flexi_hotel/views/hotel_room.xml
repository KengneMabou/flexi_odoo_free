<?xml version="1.0" encoding="utf-8" ?>
<odoo>
	<data>
        <record id="flexih_hotel_room_view_form" model="ir.ui.view">
            <field name="name">flexih_hotel_room_view_form</field>
            <field name="model">hotel.room</field>
            <field name="inherit_id" ref="hotel_management_odoo.hotel_room_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='floor_id']" position="after">
                    <field name="category_id"/>
                    <field name="pricing_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>