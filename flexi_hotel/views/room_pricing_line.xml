<?xml version="1.0" encoding="utf-8" ?>
<odoo>
	<data>
		<record id="room_pricing_line_view_form" model="ir.ui.view">
			<field name="name">room_pricing_line_view_form</field>
			<field name="model">room.pricing.line</field>
			<field name="arch" type="xml">
				<form>
					<sheet>
						<group name="general_infos">
							<field name="amount" />
							<field name="provision_id" />
							<field name="pricing_id" />
							<field name="company_id" invisible="1"/>
						</group>
					</sheet>
					<div class="oe_chatter">
						<field name="message_follower_ids" widget="mail_followers" />
						<field name="message_ids" widget="mail_thread" />
					</div>
				</form>
			</field>
		</record>

		<record id="room_pricing_line_view_tree" model="ir.ui.view">
			<field name="name">room_pricing_line_view_tree</field>
			<field name="model">room.pricing.line</field>
			<field name="arch" type="xml">
				<tree>
					<field name="amount" />
					<field name="provision_id" />
					<field name="pricing_id" />
				</tree>
			</field>
		</record>
		<record model="ir.actions.act_window" id="act_open_room_pricing_line_view">
		    <field name="name">Room category</field>
		    <field name="type">ir.actions.act_window</field>
		    <field name="res_model">room.pricing.line</field>
		    <field name="view_mode">tree,form</field>
		    <field name="domain">[]</field>
		    <field name="context">{}</field>
		</record>
		
		<record model="ir.actions.act_window.view" id="act_open_room_pricing_line_view_form">
		    <field name="act_window_id" ref="act_open_room_pricing_line_view"/>
		    <field name="sequence" eval="20"/>
		    <field name="view_mode">form</field>
		    <field name="view_id" ref="room_pricing_line_view_form"/>
		</record>
		
		<record model="ir.actions.act_window.view" id="act_open_room_pricing_line_view_tree">
		    <field name="act_window_id" ref="act_open_room_pricing_line_view"/>
		    <field name="sequence" eval="10"/>
		    <field name="view_mode">tree</field>
		    <field name="view_id" ref="room_pricing_line_view_tree"/>
		</record>
		
	</data>
</odoo>
