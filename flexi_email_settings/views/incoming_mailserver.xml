<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_flexi_email_server_tree" model="ir.actions.act_window">
            <field name="name">Incoming Mail Servers</field>
            <field name="res_model">fetchmail.server</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="mail.view_email_server_tree"/>
            <field name="search_view_id" ref="mail.view_email_server_search"/>
            <field name="domain">[('owner_setting_user_id','=',uid), ('is_personal_settings','=',True)]</field>
            <field name="context">{'is_personal_settings':True}</field>
        </record>
        <menuitem id="menu_incoming_mailserver" name="Incoming mailserver"
                  sequence="2"
                  parent="menu_flexi_email_settings_root"
                  action="action_flexi_email_server_tree"
                />
    </data>
</odoo>