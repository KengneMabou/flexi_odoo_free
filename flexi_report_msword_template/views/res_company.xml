<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_msword_res_company_form" model="ir.ui.view">
        <field name="name">report_msword_res_company_form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[1]" position="after">
                <page string="MS word reporting" name="report_msword">
                    <group>
                        <field name="gotenberg_http_base_url"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
