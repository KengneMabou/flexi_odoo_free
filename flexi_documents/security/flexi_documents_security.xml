<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data noupdate="0">

        <record id="module_category_flexi_documents" model="ir.module.category">
            <field name="name">Documents</field>
            <field name="sequence">79</field>
        </record>

        <!--Groupes-->

        <record id="group_flexi_documents_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="category_id" ref="module_category_flexi_documents"/>
            <field name="users" eval="[(4, ref('base.user_root')),(4, ref('base.user_admin'))]"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_flexi_documents_editor" model="res.groups">
            <field name="name">Editeur</field>
            <field name="category_id" ref="module_category_flexi_documents"/>
            <field name="users" eval="[(4, ref('base.user_root')),(4, ref('base.user_admin'))]"/>
            <field name="implied_ids" eval="[(4, ref('flexi_documents.group_flexi_documents_user'))]"/>
        </record>

        <record id="group_flexi_documents_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_flexi_documents"/>
            <field name="users" eval="[(4, ref('base.user_root')),(4, ref('base.user_admin'))]"/>
            <field name="implied_ids" eval="[(4, ref('flexi_documents.group_flexi_documents_editor'))]"/>
        </record>

        <!-- records rule-->

        <record id="document_content_rule_for_global" model="ir.rule">
            <field name="name">Accès aux contenus de documents pour les utilisateurs et les éditeurs</field>
            <field name="model_id" ref="model_flexi_document_content"/>
            <field name="domain_force">[('visibility_user_ids','in',user.id),('company_id','=',user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('flexi_documents.group_flexi_documents_user'))]"/>
        </record>

        <record id="document_content_rule_for_global" model="ir.rule">
            <field name="name">Accès aux contenus de documents pour les managers</field>
            <field name="model_id" ref="model_flexi_document_content"/>
            <field name="domain_force">[('company_id','=',user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('flexi_documents.group_flexi_documents_manager'))]"/>
        </record>

        <record id="document_location_rule_for_global" model="ir.rule">
            <field name="name">Accès aux emplacement de documents par société</field>
            <field name="model_id" ref="model_flexi_document_location"/>
            <field name="domain_force">[('company_id','=',user.company_id.id)]</field>
        </record>

        <record id="document_folder_rule_for_global" model="ir.rule">
            <field name="name">Accès aux dossiers de documents par société</field>
            <field name="model_id" ref="model_flexi_document_folder"/>
            <field name="domain_force">[('company_id','=',user.company_id.id)]</field>
        </record>

	</data>
</odoo>
