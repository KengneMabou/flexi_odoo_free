<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="flexi_documents_res_company_form" model="ir.ui.view">
        <field name="name">flexi_documents_res_company_form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[1]" position="after">
                <page string="Documents" name="documents_management">
                    <group>
                        <field name="document_profile_heritage"/>
                        <field name="archive_expired_documents" widget="boolean_toggle"/>
                        <field name="max_expiry_notification"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
