<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="flexi_document_content_form" model="ir.ui.view">
            <field name="name">flexi.document.content.form</field>
            <field name="model">flexi.document.content</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group name="basic_infos" string="Informations de base">
                                <field name="name"/>
                                <field name="folder_id"/>
                                <field name="year_id"/>
                                <field name="month_id"/>
                                <field name="location_id"/>
                                <field name="notes"/>
                            </group>
                            <group name="access_infos" string="Gestion des accès">
                                <field name="visibility_type"/>
                                <field name="selected_user_ids" widget="many2many_tags"
                                       invisible = "visibility_type != 'selected_users'"
                                       required = "visibility_type == 'selected_users'" />

                                <field name="selected_profile_ids" widget="many2many_tags"
                                       invisible = "visibility_type != 'selected_profiles'"
                                       required = "visibility_type == 'selected_profiles'"/>

                                <field name="emission_date"/>

                                <field name="expiration_date"/>

                                <field name="expiry_notify_delay"/>

                                <field name="max_expiry_notification"
                                       invisible = "expiration_date == False"
                                       required = "expiration_date != False"/>

                                <field name="auto_archive_if_expired" widget="boolean_toggle"/>

                                <field name="expiry_user_ids" widget="many2many_tags"
                                       invisible = "expiration_date == False"
                                       required = "expiration_date != False"/>

                                <field name="is_expired" readonly="1" widget="boolean_toggle"/>

                                <field name="notification_date" readonly="1"/>

                                <field name="total_expiry_notification" readonly="1"/>

                                <field name="company_id" groups="base.group_multi_company" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Fichiers" name="attachment_ids">
                                <field name="attachment_ids" widget="many2many_binary" string="Joindre des fichiers" nolabel="1" colspan="2"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                        <field name="activity_ids" widget="mail_activity"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="flexi_document_content_tree" model="ir.ui.view">
            <field name="name">flexi.document.content.tree</field>
            <field name="model">flexi.document.content</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="folder_id"/>
                    <field name="year_id"/>
                    <field name="month_id"/>
                    <field name="location_id" optional="hide"/>
                    <field name="company_id" groups="base.group_multi_company" optional="show"/>
                </tree>
            </field>
        </record>

        <record id="flexi_document_content_kanban" model="ir.ui.view">
            <field name="name">flexi.document.content.kanban</field>
            <field name="model">flexi.document.content</field>
            <field name="priority" eval="100"/>
            <field name="arch" type="xml">
                <kanban class="oe_background_grey o_kanban_dashboard o_emphasize_colors" sample="1">
                    <field name="name"/>
                    <field name="folder_id"/>
                    <field name="year_id"/>
                    <field name="month_id"/>
                    <field name="location_id"/>
                    <field name="notes"/>
                    <field name="visibility_type"/>
                    <field name="selected_user_ids"/>
                    <field name="selected_profile_ids"/>
                    <field name="company_id"/>
                    <field name="attachment_ids"/>
                    <field name="create_date"/>
                    <field name="create_uid"/>
                    <field name="expiration_date"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_content oe_kanban_global_click ">
                                <div>
                                    <strong class="o_kanban_record_title"><span><t t-esc="record.name.value"/></span></strong>
                                </div>
                                <div>
                                    <span class="o_kanban_record_subtitle">Fichiers : <t t-esc="record.attachment_ids.value" widget="many2many_binary"/></span>
                                </div>
                                <div>
                                    <span class="o_kanban_record_subtitle">Dossier : <t t-esc="record.folder_id.value"/></span>
                                </div>
                                <div>
                                    <span class="o_kanban_record_subtitle">Année : <t t-esc="record.year_id.value"/></span>
                                </div>
                                <div>
                                    <span class="o_kanban_record_subtitle">Mois : <t t-esc="record.month_id.value"/></span>
                                </div>
                                <div>
                                    <span class="o_kanban_record_subtitle">Emplacement : <t t-esc="record.location_id.value"/></span>
                                </div>
                                <div>
                                    <span class="o_kanban_record_subtitle">Date d'expiration : <t t-esc="record.expiration_date.value"/></span>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <div class="o_kanban_inline_block">
                                            <span class="o_kanban_record_subtitle">Créé le : <t t-esc="record.create_date.value"/></span>
                                        </div>
                                        <div class="o_kanban_inline_block">
                                            <span class="o_kanban_record_subtitle">Créé par : <t t-esc="record.create_uid.value" widget="many2one_avatar_user" /> </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="flexi_document_content_search" model="ir.ui.view">
            <field name="name">flexi.document.content.search</field>
            <field name="model">flexi.document.content</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_flexi_document_content_view">
            <field name="name">Contenu de document</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">flexi.document.content</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="flexi_document_content_search"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_flexi_document_content_view_form">
            <field name="act_window_id" ref="act_flexi_document_content_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="flexi_document_content_form"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_flexi_document_content_view_tree">
            <field name="act_window_id" ref="act_flexi_document_content_view"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="flexi_document_content_tree"/>
        </record>
        
        <record model="ir.actions.act_window.view" id="act_flexi_document_content_view_kanban">
            <field name="act_window_id" ref="act_flexi_document_content_view"/>
            <field name="sequence" eval="5"/>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="flexi_document_content_kanban"/>
        </record>

        <menuitem id="menu_flexi_document_content"
                  name="Contenu de document"
                  sequence="10"
                  parent="menu_flexi_documents_management"
                  action="act_flexi_document_content_view"/>
    </data>
</odoo>
