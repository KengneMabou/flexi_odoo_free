<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="flexi_document_folder_form" model="ir.ui.view">
            <field name="name">flexi.document.folder.form</field>
            <field name="model">flexi.document.folder</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="parent_id"/>
                                <field name="complete_name" invisible="1"/>
                                <field name="company_id" groups="base.group_multi_company" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Sous-dossiers" name="child_ids">
                                <field name="child_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                        <field name="activity_ids" widget="mail_activity"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="flexi_document_folder_tree" model="ir.ui.view">
            <field name="name">flexi.document.folder.tree</field>
            <field name="model">flexi.document.folder</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="parent_id"/>
                    <field name="company_id" groups="base.group_multi_company" optional="show"/>
                </tree>
            </field>
        </record>

        <record id="flexi_document_folder_search" model="ir.ui.view">
            <field name="name">flexi.document.folder.search</field>
            <field name="model">flexi.document.folder</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="parent_id"/>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_flexi_document_folder_view">
            <field name="name">Dossier de document</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">flexi.document.folder</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="flexi_document_folder_search"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_flexi_document_folder_view_form">
            <field name="act_window_id" ref="act_flexi_document_folder_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="flexi_document_folder_form"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_flexi_document_folder_view_tree">
            <field name="act_window_id" ref="act_flexi_document_folder_view"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="flexi_document_folder_tree"/>
        </record>
        
        <menuitem id="menu_flexi_document_folder"
                  name="Dossier de document"
                  sequence="11"
                  parent="menu_flexi_documents_management"
                  action="act_flexi_document_folder_view"/>

    </data>
</odoo>
